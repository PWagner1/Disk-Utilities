<Window
    x:Class="HandleFinder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:HandleFinder.Models"
    Title="HandleFinder">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent" Padding="24,0,120,0" VerticalAlignment="Top">
            <TextBlock Text="HandleFinder" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="24" RowSpacing="16" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ElevationBanner" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElevationBannerText" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="RestartAsAdminButton" Grid.Column="1" Content="Restart as administrator" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="Find which processes have handles open to a file, folder, or drive. Enter a path, select a drive, or browse."
                           TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="Drive, file, or folder path" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DriveCombo"
                              PlaceholderText="Select drive..."
                              Width="80"
                              DisplayMemberPath="DisplayText"
                              SelectionChanged="DriveCombo_SelectionChanged" />
                    <TextBox x:Name="PathBox"
                             PlaceholderText="C:\ or C:\path\to\file.txt"
                             Width="350"
                             HorizontalAlignment="Stretch" />
                    <Button x:Name="BrowseButton" Content="Browse...">
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Browse folder" Click="BrowseFolder_Click" />
                                <MenuFlyoutItem Text="Browse file" Click="BrowseFile_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="FindButton" Content="Find handles" Click="FindButton_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4" MinHeight="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text="Processes locking this path" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="ReloadButton" Content="Reload" Click="ReloadButton_Click" ToolTipService.ToolTip="Re-scan the current path" />
                        <Button x:Name="CloseHandleButton" Content="Close handle" Click="CloseHandleButton_Click" IsEnabled="False" />
                        <Button x:Name="EndProcessButton" Content="End process" Click="EndProcessButton_Click" IsEnabled="False" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              x:Name="HandlesList"
                              SelectionMode="Single"
                              SelectionChanged="HandlesList_SelectionChanged">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Process" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="PID" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Path" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HandleInfo">
                                <Expander>
                                    <Expander.Header>
                                        <Grid Padding="8,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind ProcessName}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ProcessId}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Padding="8,4" Spacing="4" Opacity="0.9">
                                        <TextBlock>
                                            <Run Text="Handle: " FontWeight="SemiBold"/>
                                            <Run Text="{x:Bind HandleValue, Mode=OneTime}"/>
                                        </TextBlock>
                                        <TextBlock>
                                            <Run Text="Access: " FontWeight="SemiBold"/>
                                            <Run Text="{x:Bind GrantedAccess, Mode=OneTime}"/>
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3"/>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Spacing="8">
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
