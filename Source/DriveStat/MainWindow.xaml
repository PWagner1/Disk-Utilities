<Window
    x:Class="DriveStat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DriveStat.Controls"
    xmlns:models="using:DriveStat.Models"
    Title="DriveStat - Disk Usage Statistics">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent" Padding="24,0,120,0" VerticalAlignment="Top">
            <TextBlock Text="DriveStat" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="24" RowSpacing="12" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Select a drive or folder to analyze disk usage. The treemap shows file sizes at a glance."
                           TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="DriveCombo"
                              PlaceholderText="Select drive or folder..."
                              Width="320"
                              SelectionChanged="DriveCombo_SelectionChanged" />
                    <Button x:Name="BrowseButton" Content="Browse..." Click="BrowseButton_Click" />
                    <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" />
                    <Button x:Name="HeatMapButton" Content="Heat map" Click="HeatMapButton_Click" IsEnabled="False" ToolTipService.ToolTip="Open heat map in new window (scan first)" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Visibility="Collapsed" />
                </StackPanel>
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="12" MinHeight="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="150" MaxWidth="400" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="200" MinWidth="120" MaxWidth="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Directory tree" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TreeView x:Name="DirectoryTree"
                                  Grid.Row="1"
                                  SelectionChanged="DirectoryTree_SelectionChanged"
                                  CanDragItems="False"
                                  CanReorderItems="False">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Content.Name}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Content.FormattedSize}" VerticalAlignment="Center" Opacity="0.7" />
                                        <StackPanel.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Open in Explorer" Click="OpenInExplorer_Click" />
                                            </MenuFlyout>
                                        </StackPanel.ContextFlyout>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button x:Name="TreemapBackButton" Content="↑ Up" Click="TreemapBackButton_Click" Visibility="Collapsed" ToolTipService.ToolTip="Go to parent folder" />
                            <TextBlock Text="Treemap" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="(click a folder to expand)" VerticalAlignment="Center" Opacity="0.7" FontSize="11" />
                            <Button x:Name="ZoomOutButton" Content="-" Width="28" Height="28" Padding="0" Click="ZoomOutButton_Click" ToolTipService.ToolTip="Zoom out" />
                            <Button x:Name="ZoomInButton" Content="+" Width="28" Height="28" Padding="0" Click="ZoomInButton_Click" ToolTipService.ToolTip="Zoom in" />
                            <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" MinWidth="40" />
                        </StackPanel>
                        <ScrollViewer x:Name="TreemapScrollViewer" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4"
                                      ViewChanged="TreemapScrollViewer_ViewChanged">
                            <controls:TreemapControl x:Name="Treemap"
                                                     SelectionChanged="Treemap_SelectionChanged"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch"
                                                     MinHeight="200" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Text="Extensions" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="ShowAllButton" Content="Show all" Click="ShowAllButton_Click" Visibility="Collapsed" Padding="8,4" />
                        </StackPanel>
                        <ListView x:Name="ExtensionList"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="ExtensionList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ExtensionInfo">
                                    <Grid Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="2"
                                                Background="{x:Bind ColorBrush}"
                                                VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Extension}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind FileCountDisplay}" FontSize="11" Opacity="0.8" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeFormatted}" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
