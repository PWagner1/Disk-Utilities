<Window
    x:Class="DriveStat.HeatMapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Heat Map">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent" Padding="24,0,24,0" VerticalAlignment="Top">
            <TextBlock x:Name="TitleText" Text="Heat Map" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Padding="24,8,24,8">
            <TextBlock Text="Color intensity = size (cool = small, hot = large)" VerticalAlignment="Center" Opacity="0.8" FontSize="12" />
            <Border Width="120" Height="16" CornerRadius="2" HorizontalAlignment="Left">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2062A8" Offset="0" />
                        <GradientStop Color="#3A9D23" Offset="0.33" />
                        <GradientStop Color="#E6C229" Offset="0.66" />
                        <GradientStop Color="#C0392B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="HeatMapScrollViewer"
                      Padding="24,0,24,24"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="4"
                      ViewChanged="HeatMapScrollViewer_ViewChanged">
            <Canvas x:Name="HeatMapCanvas" Background="Transparent" />
        </ScrollViewer>
    </Grid>
</Window>
