<Window
    x:Class="DriveStat.FileInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Properties">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent" Padding="24,0,24,0" VerticalAlignment="Top">
            <TextBlock x:Name="TitleText" Text="Properties" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <TabView Grid.Row="1" Padding="24,0,24,0">
            <TabViewItem Header="General">
        <ScrollViewer Padding="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="16" MaxWidth="500">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="48" Height="48" CornerRadius="4" Background="#20FFFFFF" Padding="12" VerticalAlignment="Top">
                            <TextBlock x:Name="ItemIconText" Text="📁" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="ItemNameText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ItemTypeText" FontSize="12" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Location" FontWeight="SemiBold" FontSize="12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Grid.Column="0" IsReadOnly="True" TextWrapping="NoWrap" BorderThickness="1" Padding="8,6" />
                            <Button x:Name="ExplorePathButton" Grid.Column="1" Content="Explore" Click="ExplorePathButton_Click" VerticalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Properties" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel x:Name="PropertiesPanel" Spacing="8" />
                    </StackPanel>

                    <StackPanel x:Name="AttributesSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Attributes" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel x:Name="AttributesPanel" Spacing="6" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8" Margin="24,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="RevealButton" Content="Reveal in Explorer" Click="RevealButton_Click" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Icons">
                <ScrollViewer Padding="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="IconsPanel" Spacing="16" MaxWidth="500" />
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Details">
                <ScrollViewer Padding="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailsPanel" Spacing="12" MaxWidth="500" />
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Security">
                <ScrollViewer Padding="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SecurityPanel" Spacing="12" MaxWidth="500" />
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Digital Signatures">
                <ScrollViewer Padding="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SignaturesPanel" Spacing="12" MaxWidth="500" />
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Border Grid.Row="2" Padding="24,16" BorderBrush="Gray" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button x:Name="ApplyButton" Content="Apply" Click="ApplyButton_Click" IsEnabled="False" Visibility="Collapsed" />
                <Button x:Name="CloseButton" Content="OK" Click="CloseButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
