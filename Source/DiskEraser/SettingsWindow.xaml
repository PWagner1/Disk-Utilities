<Window
    x:Class="DiskEraser.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: Mica shows through; this element is the drag region -->
        <Grid x:Name="SettingsTitleBar" Grid.Row="0" Height="48" Background="Transparent" Padding="24,0,24,0" VerticalAlignment="Top">
            <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Background="Transparent" Padding="24" RowSpacing="16" ColumnSpacing="12">
            <Grid.Resources>
                <Flyout x:Name="ColourPickerFlyout">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ColourPickerTitle"
                                   Text="Pick colour"
                                   FontWeight="SemiBold" />
                        <ColorPicker x:Name="ColourPicker"
                                     IsAlphaEnabled="False"
                                     IsMoreButtonVisible="False"
                                     IsColorPreviewVisible="False"
                                     ColorSpectrumShape="Ring"
                                     ColorChanged="ColourPicker_ColorChanged" />
                    </StackPanel>
                </Flyout>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Appearance" FontWeight="SemiBold" FontSize="14" />
            <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="Theme" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeCombo" Width="200" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Diagram colours" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Grid.Row="3" Text="Choose colours for the drive layout diagram and pie chart. Changes apply when you save." TextWrapping="Wrap" Opacity="0.8" FontSize="12" />

            <StackPanel Grid.Row="4" Spacing="6">
                <TextBlock Text="Formattable partitions" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="FormattableColourCombo" Width="180" SelectionChanged="ColourCombo_SelectionChanged" />
                    <Border x:Name="FormattableColourPreview"
                            Width="40" Height="28"
                            CornerRadius="4"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Tapped="ColourPreview_Tapped" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="5" Spacing="6">
                <TextBlock Text="System drive (C:)" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="SystemDriveColourCombo" Width="180" SelectionChanged="ColourCombo_SelectionChanged" />
                    <Border x:Name="SystemDriveColourPreview"
                            Width="40" Height="28"
                            CornerRadius="4"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Tapped="ColourPreview_Tapped" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="6" Spacing="6">
                <TextBlock Text="No drive letter" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="NoLetterColourCombo" Width="180" SelectionChanged="ColourCombo_SelectionChanged" />
                    <Border x:Name="NoLetterColourPreview"
                            Width="40" Height="28"
                            CornerRadius="4"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Tapped="ColourPreview_Tapped" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="7" Spacing="6">
                <TextBlock Text="Unallocated space" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="UnallocatedColourCombo" Width="180" SelectionChanged="ColourCombo_SelectionChanged" />
                    <Border x:Name="UnallocatedColourPreview"
                            Width="40" Height="28"
                            CornerRadius="4"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Tapped="ColourPreview_Tapped" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
