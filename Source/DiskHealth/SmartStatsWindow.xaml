<Window
    x:Class="DiskHealth.SmartStatsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="S.M.A.R.T. Drive Health">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent" Padding="24,0,120,0" VerticalAlignment="Top">
            <TextBlock Text="S.M.A.R.T. Drive Health" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="24" RowSpacing="12" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="DriveToolbar" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <ComboBox x:Name="SmartDriveCombo"
                          PlaceholderText="Select a physical drive..."
                          DisplayMemberPath="DisplayText"
                          Width="450"
                          SelectionChanged="SmartDriveCombo_SelectionChanged" />
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <TextBlock Text="Health:" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="SmartHealthText" Text="—" VerticalAlignment="Center" />
                <TextBlock x:Name="DriveKindText" Text="" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="2" x:Name="HealthCard" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Health score:" FontWeight="SemiBold" />
                        <TextBlock x:Name="HealthScoreText" Text="—" />
                    </StackPanel>
                    <ProgressBar x:Name="HealthScoreBar" Minimum="0" Maximum="100" Value="0" Height="8" />
                    <TextBlock x:Name="HealthSummaryText" Text="No drive selected." Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Temperature" FontWeight="SemiBold" Opacity="0.8" />
                        <TextBlock x:Name="TempCardText" Text="—" FontSize="22" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Available spare" FontWeight="SemiBold" Opacity="0.8" />
                        <TextBlock x:Name="SpareCardText" Text="—" FontSize="22" />
                        <TextBlock Text="NVMe SSD wear reserve" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Percentage used" FontWeight="SemiBold" Opacity="0.8" />
                        <TextBlock x:Name="WearCardText" Text="—" FontSize="22" />
                        <TextBlock Text="NVMe life used estimate" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" Opacity="0.8" />
                <TextBlock Grid.Column="1" Text="Attribute" FontWeight="SemiBold" Opacity="0.8" />
                <TextBlock Grid.Column="2" Text="Value" FontWeight="SemiBold" Opacity="0.8" />
                <TextBlock Grid.Column="3" Text="Worst" FontWeight="SemiBold" Opacity="0.8" />
                <TextBlock Grid.Column="4" Text="Raw" FontWeight="SemiBold" Opacity="0.8" />
            </Grid>

            <ListView Grid.Row="5"
                      x:Name="SmartAttributesList"
                      MinHeight="240"
                      IsItemClickEnabled="False"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding IdHex}" VerticalAlignment="Center" Opacity="0.8" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Worst}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding DisplayValue}" VerticalAlignment="Center" Opacity="0.9" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
