<Window
    x:Class="DiskHealth.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Disk Health">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent" Padding="24,0,120,0" VerticalAlignment="Top">
            <TextBlock Text="Disk Health" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="24" RowSpacing="12" ColumnSpacing="12" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Scan a drive for recoverable files, view recovery chances, and recover selected files to a destination folder. Administrator privileges are required for scanning."
                           TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="Drive" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DriveCombo"
                              PlaceholderText="Select a drive to scan..."
                              DisplayMemberPath="DisplayText"
                              Width="280"
                              SelectionChanged="DriveCombo_SelectionChanged" />
                    <Button x:Name="ScanButton" Content="Scan for recoverable files" Click="ScanButton_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock Text="Recovery destination" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="DestinationBox"
                             PlaceholderText="C:\RecoveredFiles"
                             Width="400"
                             IsReadOnly="True" />
                    <Button x:Name="BrowseButton" Content="Browse..." Click="BrowseButton_Click" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Padding="12" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <TextBlock Text="Recoverable files" FontWeight="SemiBold" />
                        <CheckBox x:Name="SelectAllCheck" Content="Select all" IsChecked="True" Checked="SelectAllCheck_Changed" Unchecked="SelectAllCheck_Changed" />
                        <TextBlock x:Name="FileCountText" Text="0 files found" Opacity="0.8" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              x:Name="FileListView"
                              MinHeight="200"
                              SelectionMode="Multiple"
                              CanDragItems="False"
                              CanReorderItems="False"
                              SelectionChanged="FileListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding RecoveryChanceLabel}" VerticalAlignment="Center" Opacity="0.9" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding FileType}" VerticalAlignment="Center" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Row="4" Spacing="8">
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Visibility="Collapsed" Value="0" Minimum="0" Maximum="100" />
                <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshButton" Content="Refresh drives" Click="RefreshButton_Click" />
                    <Button x:Name="RecoverButton" Content="Recover selected" Click="RecoverButton_Click" />
                    <Button x:Name="SmartStatsButton" Content="S.M.A.R.T. stats..." Click="SmartStatsButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
