<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DiskSeer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscUtils.Core" Version="$(DiscUtilsVersion)" />
    <PackageReference Include="DiscUtils.Ext" Version="$(DiscUtilsVersion)" />
    <PackageReference Include="DiscUtils.HfsPlus" Version="$(DiscUtilsVersion)" />
    <PackageReference Include="DiscUtils.Xfs" Version="$(DiscUtilsVersion)" />
    <PackageReference Include="DiscUtils.Btrfs" Version="$(DiscUtilsVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(WindowsSdkBuildToolsVersion)" />
    <PackageReference Include="System.Management" Version="$(SystemManagementVersion)" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskUtilities.Shared\DiskUtilities.Shared.csproj" />
  </ItemGroup>

  <!-- Ship APFS build instructions next to the exe for the in-app "Open build docs" button -->
  <ItemGroup>
    <Content Include="Docs\LIBFSAPFS_BUILD.md" CopyToOutputDirectory="PreserveNewest" Link="Docs\LIBFSAPFS_BUILD.md" />
  </ItemGroup>

</Project>
