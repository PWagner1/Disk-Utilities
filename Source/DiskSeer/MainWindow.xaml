<Window
    x:Class="DiskSeer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="DiskSeer">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent" Padding="24,0,120,0" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE74E;" FontSize="18" />
                <TextBlock Text="DiskSeer - Foreign File System Browser" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Padding="24" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ElevationBanner" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElevationBannerText" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="RestartAsAdminButton" Grid.Column="1" Content="Restart as administrator" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Drive selection -->
            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="Read and modify drives formatted with Apple (HFS+) or Linux (ext2/3/4, Btrfs, XFS) file systems."
                           TextWrapping="Wrap" Opacity="0.8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="DriveCombo"
                              PlaceholderText="Select a drive..."
                              Width="350"
                              SelectionChanged="DriveCombo_SelectionChanged" />
                    <ComboBox x:Name="PartitionCombo"
                              PlaceholderText="Select a partition..."
                              Width="350"
                              SelectionChanged="PartitionCombo_SelectionChanged"
                              IsEnabled="False" />
                    <Button x:Name="RefreshDrivesButton" Content="Refresh" Click="RefreshDrivesButton_Click">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="OpenPartitionButton" Content="Open" Click="OpenPartitionButton_Click" IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <!-- Navigation bar -->
            <Grid Grid.Row="2" Margin="0,16,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Margin="0,0,4,0" Click="BackButton_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Go back (Alt+Left)">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="ForwardButton" Grid.Column="1" Margin="0,0,4,0" Click="ForwardButton_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Go forward (Alt+Right)">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="UpButton" Grid.Column="2" Margin="0,0,8,0" Click="UpButton_Click" IsEnabled="False"
                        ToolTipService.ToolTip="Go up one level (Alt+Up)">
                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                </Button>

                <!-- Breadcrumb path -->
                <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsRepeater x:Name="BreadcrumbRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Name}"
                                            Tag="{Binding Path}"
                                            Click="BreadcrumbItem_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8,4" />
                                    <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" Opacity="0.5" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <AutoSuggestBox x:Name="SearchBox" Grid.Column="4" Width="200" PlaceholderText="Search files..."
                                QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
            </Grid>

            <!-- File browser -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- File list -->
                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyStatePanel" Visibility="Visible"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE74E;" FontSize="48" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a drive and partition to browse" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" Opacity="0.7" />
                        </StackPanel>

                        <!-- Loading indicator -->
                        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="48" Height="48" />
                            <TextBlock x:Name="LoadingText" Text="Loading..." HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- File list view -->
                        <ListView x:Name="FileListView" Visibility="Collapsed"
                                  SelectionMode="Extended"
                                  SelectionChanged="FileListView_SelectionChanged"
                                  DoubleTapped="FileListView_DoubleTapped"
                                  RightTapped="FileListView_RightTapped">
                            <ListView.Header>
                                <Grid Padding="12,8" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Modified" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="16" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Opacity="0.7" />
                                        <TextBlock Grid.Column="3" Text="{Binding DisplayDate}" Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open" Icon="OpenFile" Click="OpenMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="CopyToLocalMenuItem" Text="Copy to local..." Icon="Copy" Click="CopyToLocalMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="CopyFromLocalMenuItem" Text="Copy from local..." Icon="Paste" Click="CopyFromLocalMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="NewFolderMenuItem" Text="New folder" Icon="NewFolder" Click="NewFolderMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="RenameMenuItem" Text="Rename" Icon="Rename" Click="RenameMenuItem_Click" />
                                    <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete" Icon="Delete" Click="DeleteMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="PropertiesMenuItem" Text="Properties" Click="PropertiesMenuItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ListView.ContextFlyout>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Details panel -->
                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailsPanel" Spacing="12">
                            <TextBlock Text="Details" FontWeight="SemiBold" FontSize="16" />

                            <!-- Volume info (shown when no file selected) -->
                            <StackPanel x:Name="VolumeInfoPanel" Spacing="8">
                                <TextBlock Text="Volume Information" FontWeight="SemiBold" Opacity="0.8" />
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="VolumeLabelText" Text="Label: -" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VolumeTypeText" Text="Type: -" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VolumeSizeText" Text="Size: -" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- File info (shown when file selected) -->
                            <StackPanel x:Name="FileInfoPanel" Spacing="8" Visibility="Collapsed">
                                <FontIcon x:Name="FileInfoIcon" Glyph="&#xE7C3;" FontSize="48" HorizontalAlignment="Left" />
                                <TextBlock x:Name="FileNameText" Text="filename.txt" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="FileTypeText" Text="Type: File" Opacity="0.8" />
                                    <TextBlock x:Name="FileSizeText" Text="Size: 0 bytes" Opacity="0.8" />
                                    <TextBlock x:Name="FileModifiedText" Text="Modified: -" Opacity="0.8" />
                                    <TextBlock x:Name="FileCreatedText" Text="Created: -" Opacity="0.8" />
                                    <TextBlock x:Name="FilePermissionsText" Text="Permissions: -" Opacity="0.8" />
                                    <TextBlock x:Name="FilePathText" Text="Path: /" Opacity="0.8" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Multi-selection info -->
                            <StackPanel x:Name="MultiSelectPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="MultiSelectText" Text="3 items selected" FontWeight="SemiBold" />
                                <TextBlock x:Name="MultiSelectSizeText" Text="Total size: 1.5 MB" Opacity="0.8" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Opacity="0.7" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressBar x:Name="OperationProgress" Width="150" Visibility="Collapsed"
                                 IsIndeterminate="False" Minimum="0" Maximum="100" />
                    <Button x:Name="CancelOperationButton" Content="Cancel" Visibility="Collapsed"
                            Click="CancelOperationButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
